# =============================================================================
# Braivex Vaani environment template.
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ---- Supabase (the only auth and data store) -------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Session-pooler connection string from Supabase > Project Settings > Database.
VAANI_DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
# Optional CA override. The bundled cert is used by default.
# VAANI_DB_SSLROOTCERT=./certs/supabase-pooler-ca.pem

# ---- Server ----------------------------------------------------------------
PORT=8787
# Set to 1 when running behind a trusted reverse proxy.
TRUST_PROXY=0
# Public origin used for cross-origin checks, for example https://crm.example.com
# PUBLIC_ORIGIN=
# Auto-confirm new signups without an email link. Only for local/dev or a
# project with no SMTP. Leave unset in production so emails are verified.
# BRAIVEX_AUTO_CONFIRM_SIGNUP=1

# ---- Vaani ingestion webhooks ---------------------------------------------
# Bearer secret for POST /api/v1/vaani/calls/complete and /extract.
VAANI_INGESTION_SECRET=
# Secret for POST /api/v1/vaani/whatsapp/webhook. Falls back to the value above.
VAANI_WHATSAPP_WEBHOOK_SECRET=
# Workflow used for manual CRM leads. Defaults to the first active Vaani workflow.
# VAANI_WORKFLOW_ID=
# Single-tenant bridge: Vaani org that receives calls whose Dograh workflow id
# is not present in Supabase. Leave unset to reject unknown workflows.
# VAANI_INGESTION_ORG_ID=

# ---- Extraction ------------------------------------------------------------
# Groq key and model used to re-extract lead facts from the transcript.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# ---- Media URLs (optional) -------------------------------------------------
# Public base URL for stored recordings and transcripts.
# MINIO_PUBLIC_ENDPOINT=
# MINIO_BUCKET=voice-audio
