# =============================================================================
# RapidX Voice Agent Stack. Copy to .env and fill in. .env is gitignored.
# No em dashes anywhere in this codebase. Use commas or periods.
# =============================================================================

# ---- Target VPS -------------------------------------------------------------
# Fresh Ubuntu 24.04, 4GB RAM recommended. 2GB works with the swapfile the
# deploy script adds. Ports 22, 80, 443 open.
VPS_IP=
SSH_KEY=~/.ssh/id_rsa

# Derived automatically as the dashed form of VPS_IP, e.g. 203-0-113-10
# Gives you HTTPS with no DNS setup. Browser mic access requires HTTPS.
# DOGRAH_HOST=<dashed-ip>.sslip.io

# ---- Dograh console login ---------------------------------------------------
# Created by signing up in the browser at STEP 3. The first signup owns org 1.
# Use this SAME account for API calls and for the browser, or the console will
# look empty while the API shows everything.
DOGRAH_EMAIL=
DOGRAH_PASSWORD=

# Dedicated org API key used by RapidX Voice Studio. Prefer this over storing
# the Dograh admin password in the dashboard container.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=
DOGRAH_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=
DOGRAH_PHONE_NUMBER_ID=

# ---- Telephony: Vobiz -------------------------------------------------------
# console.vobiz.ai. Plivo-compatible API, header auth X-Auth-ID / X-Auth-Token.
# Leave VOBIZ_APPLICATION_ID BLANK. Dograh auto-creates its own application and
# points the answer_url at your box. Reusing another product's application_id is
# the number one cause of a call that connects and then sits in silence.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=
VOBIZ_APPLICATION_ID=

# ---- Speech to text: Deepgram ----------------------------------------------
# console.deepgram.com. nova-3-general with language=multi handles Hinglish.
DEEPGRAM_API_KEY=

# ---- Brain: Groq ------------------------------------------------------------
# console.groq.com. Fast enough that the pause before a reply is not noticeable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Voice: Rumik silk ------------------------------------------------------
# rumik.ai. mulberry is the fast model, muga is the expressive one.
# Sits behind Cloudflare, the server always sends a browser User-Agent.
RUMIK_API_KEY=
RUMIK_MODEL=mulberry
RUMIK_VOICE=ira

# ---- Verification -----------------------------------------------------------
# The phone you will actually answer to confirm the stack works.
TEST_NUMBER=

# =============================================================================
# Optional. The zero-dependency management dashboard (deploy/06).
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DASHBOARD_PORT=8787

# ---- Vaani Ingestion Webhook Authentication --------------------------------
# Dedicated service-to-service secret for POST /api/v1/vaani/calls/complete
VAANI_INGESTION_SECRET=

# ---- Vaani Internal Inventory API (server-to-server) -------------------------
# Shared secret for GET /api/vaani/internal/machines (Dograh engine -> dashboard).
# Contract (see docs/vaani-internal-inventory-tool.json for the tool spec):
# - Request header:  x-vaani-internal-secret: <this value>
# - Required query:  buyer_run_id=<workflow run id> (positive integer).
#   buyer_run_id must be server-templated from the live run context
#   ({{initial_context.workflow_run_id}}); never let the LLM choose it.
# - Org scope:       resolved server-side from the buyer row. A client-supplied
#   organization_id is never trusted and is not read by the endpoint.
# - Success:         200 { machines: [...], count: N }. Sold/unavailable rows
#   are excluded unless an explicit ?status= filter is passed.
# - Failures:        403 bad secret, 400 missing buyer_run_id, 404 unknown or
#   non-buyer run, 500 generic (no internals echoed).
# Provisioning (no real values here, ever):
# - Generate:  openssl rand -hex 32   (run locally, paste only into real .env)
# - Set the SAME value in the dashboard process env and in ONE Dograh
#   organization-scoped custom-header credential per org
#   (header name x-vaani-internal-secret). Prefer per-org values so a leak
#   cannot be replayed against another org's buyer rows.
# - Rotate by updating both sides, then restart the dashboard process only.
#   No container rebuild is needed. Keep the tool row in DRAFT status and
#   unattached to Workflow 3 until integration is approved.
VAANI_INTERNAL_API_SECRET=
